{
  "name": "minip2p-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "example": "pnpm --filter react-native-minip2p-example",
    "format": "ultracite fix bindings/ts docs/blume.config.ts package.json pnpm-workspace.yaml turbo.json tsconfig.base.json vitest.config.ts oxlint.config.ts oxfmt.config.ts",
    "lint": "ultracite check bindings/ts docs/blume.config.ts package.json pnpm-workspace.yaml turbo.json tsconfig.base.json vitest.config.ts oxlint.config.ts oxfmt.config.ts",
    "test": "turbo run test",
    "test:workflows": "node --test bindings/ts/tests/workflows/*.test.mjs",
    "typecheck": "turbo run typecheck",
    "rn:android": "pnpm --filter @minip2p/react-native ubrn:android",
    "rn:generate": "pnpm --filter @minip2p/react-native ubrn:generate",
    "rn:ios": "pnpm --filter @minip2p/react-native ubrn:ios",
    "docs:dev": "pnpm --filter minip2p-docs dev",
    "docs:check": "pnpm --filter minip2p-docs check",
    "build:bindings": "turbo run build --filter=\"@minip2p/*\""
  },
  "devDependencies": {
    "js-yaml": "5.4.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "turbo": "2.10.12",
    "typescript": "catalog:",
    "ultracite": "7.11.0",
    "vitest": "5.0.0",
    "yaml": "2.9.0"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956"
}
